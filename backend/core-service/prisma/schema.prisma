generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model achievements {
  id           Int       @id @default(autoincrement())
  student_name String    @db.VarChar(200)
  photo        String?   @db.VarChar(255)
  class_name   String?   @db.VarChar(100)
  achievement  String    @db.VarChar(255)
  level        String?   @default("Kota") @db.VarChar(50)
  year         Int?
  medal        String?   @default("gold") @db.VarChar(50)
  sort_order   Int?      @default(0)
  show         Int?      @default(1)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
}

model contact_messages {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(200)
  email      String    @db.VarChar(200)
  subject    String?   @db.VarChar(255)
  message    String
  is_read    Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([is_read], map: "idx_messages_read")
}

model downloads {
  id          Int       @id @default(autoincrement())
  category    String    @db.VarChar(100)
  title       String    @db.VarChar(255)
  description String?
  url         String    @db.VarChar(500)
  file_size   String?   @db.VarChar(50)
  sort_order  Int?      @default(0)
  show        Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([category], map: "idx_downloads_category")
  @@index([sort_order], map: "idx_downloads_sort_order")
}

model events {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?
  location    String?   @db.VarChar(255)
  event_date  DateTime  @db.Date
  event_time  String?   @db.VarChar(50)
  sort_order  Int?      @default(0)
  status      String?   @default("upcoming") @db.VarChar(50)
  show        Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([event_date], map: "idx_events_date")
  @@index([status], map: "idx_events_status")
}

model extracurriculars {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  description String?
  icon        String?   @default("star") @db.VarChar(50)
  icon_color  String?   @default("#14b8a6") @db.VarChar(7)
  sort_order  Int?      @default(0)
  show        Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model faq {
  id         Int       @id @default(autoincrement())
  question   String    @db.VarChar(255)
  answer     String
  category   String?   @db.VarChar(100)
  sort_order Int?      @default(0)
  show       Int?      @default(1)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model galleries {
  id          Int       @id @default(autoincrement())
  category    String?   @db.VarChar(100)
  image       String    @db.VarChar(255)
  caption     String?   @db.VarChar(255)
  is_featured Int?      @default(0)
  sort_order  Int?      @default(0)
  show        Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model menu_items {
  id               Int          @id @default(autoincrement())
  parent_id        Int?
  title            String       @db.VarChar(200)
  url              String       @db.VarChar(255)
  target           String?      @default("_self") @db.VarChar(50)
  icon             String?      @db.VarChar(50)
  section_key      String?      @db.VarChar(100)
  sort_order       Int?         @default(0)
  status           Int?         @default(1)
  type             String?      @default("custom") @db.VarChar(20)
  page_id          Int?
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  updated_at       DateTime?    @default(now()) @db.Timestamp(6)
  pages            pages?       @relation(fields: [page_id], references: [id], onUpdate: NoAction, map: "menu_items_page_fk")
  menu_items       menu_items?  @relation("menu_itemsTomenu_items", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "menu_items_parent_fk")
  other_menu_items menu_items[] @relation("menu_itemsTomenu_items")
}

model news {
  id               Int             @id @default(autoincrement())
  category         String?         @db.VarChar(100)
  tags             Json?
  title            String          @db.VarChar(255)
  slug             String          @unique @db.VarChar(255)
  excerpt          String?
  content          String?
  image            String?         @db.VarChar(255)
  author           String?         @default("Admin") @db.VarChar(100)
  published_at     DateTime?       @db.Timestamp(6)
  status           String?         @default("draft") @db.VarChar(50)
  is_featured      Int?            @default(0)
  meta_title       String?         @db.VarChar(255)
  meta_description String?         @db.VarChar(255)
  view_count       Int?            @default(0)
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @default(now()) @db.Timestamp(6)
  news_comments    news_comments[]

  @@index([published_at], map: "idx_news_published")
  @@index([status], map: "idx_news_status")
}

model news_comments {
  id                  Int             @id @default(autoincrement())
  news_id             Int
  parent_id           Int?
  name                String          @db.VarChar(200)
  email               String?         @db.VarChar(200)
  avatar              String?         @db.VarChar(255)
  comment             String
  is_approved         Int?            @default(0)
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  updated_at          DateTime?       @default(now()) @db.Timestamp(6)
  news                news            @relation(fields: [news_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_news_fk")
  news_comments       news_comments?  @relation("news_commentsTonews_comments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_parent_fk")
  other_news_comments news_comments[] @relation("news_commentsTonews_comments")

  @@index([is_approved], map: "idx_comments_approved")
}

model pages {
  id               Int          @id @default(autoincrement())
  title            String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  content          String?
  excerpt          String?
  image            String?      @db.VarChar(255)
  status           String?      @default("draft") @db.VarChar(50)
  meta_title       String?      @db.VarChar(255)
  meta_description String?      @db.VarChar(255)
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  updated_at       DateTime?    @default(now()) @db.Timestamp(6)
  menu_items       menu_items[]
}

model programs {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  description String?
  icon        String?   @default("star") @db.VarChar(50)
  link_url    String?   @db.VarChar(255)
  link_text   String?   @default("Selengkapnya") @db.VarChar(100)
  sort_order  Int?      @default(0)
  show        Int?      @default(1)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model settings {
  id         Int       @id @default(autoincrement())
  key        String    @unique @db.VarChar(100)
  value      String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model teachers {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(200)
  photo            String?   @db.VarChar(255)
  role             String?   @db.VarChar(200)
  experience       String?   @db.VarChar(100)
  education        String?   @db.VarChar(100)
  social_facebook  String?   @db.VarChar(255)
  social_instagram String?   @db.VarChar(255)
  social_linkedin  String?   @db.VarChar(255)
  sort_order       Int?      @default(0)
  show             Int?      @default(1)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
}

model testimonials {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(200)
  photo      String?   @db.VarChar(255)
  role       String?   @db.VarChar(200)
  quote      String
  sort_order Int?      @default(0)
  show       Int?      @default(1)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  id         Int       @id @default(autoincrement())
  username   String    @unique @db.VarChar(100)
  email      String    @unique @db.VarChar(200)
  password   String    @db.VarChar(255)
  full_name  String?   @db.VarChar(200)
  avatar     String?   @db.VarChar(255)
  role       String?   @default("editor") @db.VarChar(50)
  is_active  Int?      @default(1)
  last_login DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}
