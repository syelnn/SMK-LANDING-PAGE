generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  username       String          @unique @db.VarChar(100)
  email          String          @unique @db.VarChar(200)
  password       String          @db.VarChar(255)
  fullName       String?         @map("full_name") @db.VarChar(200)
  avatar         String?         @db.VarChar(255)
  role           String?         @default("viewer") @db.VarChar(50)
  isActive       Int?            @default(1) @map("is_active")
  lastLogin      DateTime?       @map("last_login") @db.Timestamp(6)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  supabaseId     String?         @unique @map("supabase_id") @db.Uuid
  testimonials   Testimonial[]
  tracer_studies tracer_studies?

  @@map("users")
}

model Setting {
  id        Int       @id @default(autoincrement())
  key       String    @unique @db.VarChar(100)
  value     String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("settings")
}

model News {
  id          Int       @id @default(autoincrement())
  category    String?   @db.VarChar(100)
  tags        Json?
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  excerpt     String?
  content     String?
  image       String?
  author      String?   @default("Admin") @db.VarChar(100)
  publishedAt DateTime? @map("published_at") @db.Timestamp(6)
  status      String?   @default("published") @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("news")
}

model Program {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  code        String?
  title       String
  description String?
  icon        String?   @default("star")
  imageUrl    String?   @map("image_url")
  sortOrder   Int?      @default(0) @map("sort_order") @db.SmallInt
  show        Boolean?  @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([category, title], map: "uq_programs_category_title")
  @@map("programs")
}

model Extracurricular {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  show        Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("extracurriculars")
}

model Faq {
  id        Int       @id @default(autoincrement())
  question  String    @db.VarChar(255)
  answer    String
  category  String?   @db.VarChar(100)
  sortOrder Int?      @default(0) @map("sort_order")
  show      Int?      @default(1)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("faq")
}

model Gallery {
  id         Int       @id @default(autoincrement())
  category   String?   @db.VarChar(100)
  image      String
  caption    String?   @db.VarChar(255)
  isFeatured Int?      @default(0) @map("is_featured")
  sortOrder  Int?      @default(0) @map("sort_order")
  show       Int?      @default(1)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("galleries")
}

model MenuItem {
  id         Int        @id @default(autoincrement())
  parentId   Int?       @map("parent_id")
  title      String     @db.VarChar(255)
  url        String?    @db.VarChar(255)
  target     String?    @default("_self") @db.VarChar(50)
  icon       String?    @db.VarChar(255)
  sectionKey String?    @map("section_key") @db.VarChar(255)
  sortOrder  Int?       @default(0) @map("sort_order")
  status     Int?       @default(1)
  type       String?    @default("section") @db.VarChar(50)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  is_public  Boolean    @default(true)
  parent     MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade, map: "menu_items_parent_fk")
  children   MenuItem[] @relation("MenuHierarchy")

  @@map("menu_items")
}

model Teacher {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(200)
  photo     String?
  role      String?   @db.VarChar(200)
  sortOrder Int?      @default(0) @map("sort_order")
  show      Int?      @default(1)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("teachers")
}

model Testimonial {
  id        Int       @id @default(autoincrement())
  name      String
  photo     String?
  role      String
  quote     String
  sortOrder Int?      @default(0) @map("sort_order")
  show      Int?      @default(0)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  user_id   Int?
  users     User?     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("testimonials")
}

model Download {
  id            Int       @id @default(autoincrement())
  category      String    @db.VarChar(100)
  title         String    @db.VarChar(255)
  description   String?
  url           String    @db.VarChar(500)
  fileSize      String?   @map("file_size") @db.VarChar(50)
  sortOrder     Int?      @default(0) @map("sort_order")
  show          Int?      @default(1)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  public_id     String?   @db.VarChar(500)
  resource_type String?   @db.VarChar(20)

  @@index([category], map: "idx_downloads_category")
  @@index([sortOrder], map: "idx_downloads_sort_order")
  @@map("downloads")
}

model achievements {
  id           Int       @id @default(autoincrement())
  student_name String    @db.VarChar(200)
  photo        String?
  class_name   String?   @db.VarChar(100)
  achievement  String    @db.VarChar(255)
  level        String?   @default("Kota") @db.VarChar(50)
  year         Int?
  medal        String?   @default("gold") @db.VarChar(50)
  sort_order   Int?      @default(0)
  show         Int?      @default(1)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
}

model jurusan_custom {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  desc       String
  image_icon String
  subjects   String
  career     String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model program_unggulan_custom {
  id         Int      @id @default(autoincrement())
  title      String
  desc       String
  badge      String
  image_icon String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model footer_setting {
  id             Int      @id @default(autoincrement())
  school_name    String
  description    String
  address        String
  phone          String
  email          String
  facebook_url   String?
  instagram_url  String?
  maps_embed_url String?
  created_at     DateTime @default(now())
  updated_at     DateTime
  tiktok_url     String?
  twitter_url    String?
  youtube_url    String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model industry_partners {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(255)
  logo_url   String
  is_active  Boolean? @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tracer_studies {
  id                 Int       @id @default(autoincrement())
  full_name          String    @db.VarChar(200)
  nisn               String    @unique @db.VarChar(20)
  nik                String?   @db.VarChar(20)
  birth_date         DateTime  @db.Date
  domisili_kecamatan String    @db.VarChar(200)
  phone              String    @db.VarChar(20)
  angkatan           Int
  approval_status    String    @default("pending") @db.VarChar(20)
  user_id            Int?      @unique
  reviewed_by        Int?
  reviewed_at        DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now())
  jurusan            String?   @db.VarChar(100)
  status             String?   @db.VarChar(30)
  detail_tempat      String?   @db.VarChar(200)
  users              User?     @relation(fields: [user_id], references: [id])

  @@index([approval_status, angkatan])
}
